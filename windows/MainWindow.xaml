                                </GridView.ItemTemplate>
                            </GridView>
                            <local:HarborGlassCard x:Name="ModFolderDetail" Style="{StaticResource HarborPanel}" CornerRadius="24" Padding="22" Visibility="Collapsed">
                                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock x:Name="ModFolderTitle" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Style="{StaticResource HarborPill}" Content="重命名" Click="RenameModFolder_Click" />
                                        <Button Grid.Column="2" Style="{StaticResource HarborPill}" Content="×" Click="CloseModFolder_Click" AutomationProperties.Name="返回模组夹列表" ToolTipService.ToolTip="返回模组夹列表" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox x:Name="ModFolderQuery" PlaceholderText="搜索模组夹内的模组" TextChanged="ModFolderQuery_Changed" />
                                        <Button Grid.Column="1" Style="{StaticResource HarborPill}" Content="收藏本地 JAR" Click="CollectLocalFile_Click" />
                                    </Grid>
                                    <local:HarborGlassCard Grid.Row="2" Style="{StaticResource HarborPanel}" Padding="8">
                                        <ListView x:Name="ModFolderEntries" SelectionMode="Multiple">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <local:HarborGlassCard Style="{StaticResource HarborPanel}" Padding="14" CornerRadius="15">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                            <Grid Width="42" Height="42" Visibility="{Binding IconVisibility}">
                                                                <FontIcon Glyph="" FontSize="28" Opacity="0.55" />
                                                                <Image Source="{Binding IconPath}" Stretch="Uniform" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </local:HarborGlassCard>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </local:HarborGlassCard>
                                    <StackPanel Grid.Row="3" Spacing="9">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <ComboBox x:Name="ModFolderTarget" DisplayMemberPath="FriendlyName" MinWidth="190" PlaceholderText="选择目标实例" AutomationProperties.Name="导入到实例" />
                                            <Button Grid.Column="1" Style="{StaticResource HarborPill}" Content="移除所选" Click="RemoveFolderMods_Click" />
                                            <Button Grid.Column="2" Style="{StaticResource HarborProminentPill}" Content="导入所选到实例" Click="InstallFolderMods_Click" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Button Style="{StaticResource HarborPill}" Content="删除模组夹" Click="DeleteModFolder_Click" />
                                            <TextBlock Grid.Column="1" x:Name="ModFolderStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Button Grid.Column="2" x:Name="CancelModFolderButton" Style="{StaticResource HarborPill}" Content="取消任务" Click="CancelCatalog_Click" IsEnabled="False" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </local:HarborGlassCard>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="WorkspaceOverlay" Visibility="Collapsed" Canvas.ZIndex="20" TabFocusNavigation="Cycle">
            <Border x:Name="WorkspaceBlurHost" IsHitTestVisible="False" />
            <Border Background="#33000000" Tapped="WorkspaceBackdrop_Tapped" />
            <local:HarborGlassCard x:Name="WorkspaceSurface" Style="{StaticResource HarborPanel}" CornerRadius="28" Padding="0" MaxWidth="1120" Margin="28,52,28,28" HorizontalAlignment="Stretch" SizeChanged="WorkspaceSurface_SizeChanged">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid x:Name="WorkspaceHeader" Padding="28,26,28,22" ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                        <Image x:Name="WorkspaceIcon" Width="48" Height="48" />
                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                            <TextBlock x:Name="WorkspaceTitle" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" LineHeight="32" />
                            <TextBlock x:Name="WorkspaceSubtitle" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis" LineHeight="14" />
                        </StackPanel>
                        <StackPanel x:Name="WorkspaceTopActions" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0" Visibility="Visible">
                            <Button x:Name="WorkspaceLaunchButton" Style="{StaticResource HarborProminentPill}" Content="启动游戏" Click="Launch_Click" />
                            <Button x:Name="WorkspaceStopButton" Style="{StaticResource HarborPill}" Content="关闭游戏" Click="StopGame_Click" Visibility="Collapsed" />
                            <DropDownButton Content="···" CornerRadius="16" AutomationProperties.Name="实例操作">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="WorkspaceOpenDirectory" Text="打开实例目录" Click="OpenInstanceDirectory_Click" />
                                        <MenuFlyoutItem x:Name="WorkspaceRepair" Text="修复实例" Click="Repair_Click" />
                                        <MenuFlyoutItem x:Name="WorkspaceExport" Text="导出整合包" Click="ExportPack_Click" />
                                        <MenuFlyoutItem x:Name="WorkspaceRelocate" Click="RelocateInstance_Click" Text="重新定位运行目录" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Style="{StaticResource HarborPill}" Content="×" Click="CloseWorkspace_Click" AutomationProperties.Name="关闭实例管理" ToolTipService.ToolTip="关闭实例管理" x:Name="WorkspaceCloseButton" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="WorkspaceTabScroll" Grid.Row="1" Margin="24,0,24,16" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="WorkspaceTabs" Orientation="Horizontal" Spacing="5" AutomationProperties.Name="实例管理分类">
                            <Button Style="{StaticResource HarborTabPill}" Content="模组" Tag="mods" Click="WorkspaceTab_Click" Height="34" Padding="15,0" FontSize="13" />
                            <Button Style="{StaticResource HarborTabPill}" Content="资源包" Tag="resourcepacks" Click="WorkspaceTab_Click" Height="34" Padding="15,0" FontSize="13" />
                            <Button Style="{StaticResource HarborTabPill}" Content="光影" Tag="shaderpacks" Click="WorkspaceTab_Click" Height="34" Padding="15,0" FontSize="13" />
                            <Button Style="{StaticResource HarborTabPill}" Content="存档" Tag="saves" Click="WorkspaceTab_Click" Height="34" Padding="15,0" FontSize="13" />
                            <Button Style="{StaticResource HarborTabPill}" Content="汉化" Tag="localization" Click="WorkspaceTab_Click" Height="34" Padding="15,0" FontSize="13" />
                            <Button Style="{StaticResource HarborTabPill}" Content="截图" Tag="screenshots" Click="WorkspaceTab_Click" Height="34" Padding="15,0" FontSize="13" />
                            <Button Style="{StaticResource HarborTabPill}" Content="日志" Tag="logs" Click="WorkspaceTab_Click" Height="34" Padding="15,0" FontSize="13" />
                            <Button Style="{StaticResource HarborTabPill}" Content="设置" Tag="instance-settings" Click="WorkspaceTab_Click" Height="34" Padding="15,0" FontSize="13" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="WorkspaceBody" Grid.Row="2" Margin="0">
                        <Border x:Name="InstanceResourcesCard" Visibility="Collapsed" CornerRadius="0" Padding="20" Margin="0" Background="Transparent">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="ResourceQuery" PlaceholderText="搜索此实例的资源" TextChanged="ResourceQuery_Changed" />
                                    <Button Grid.Column="1" Style="{StaticResource HarborPill}" Content="下载" Click="BrowseWorkspaceResources_Click" />
                                    <Button Grid.Column="2" x:Name="ResourceImportButton" Style="{StaticResource HarborPill}" Content="导入文件" Click="ImportResource_Click" />
                                </Grid>
                                <ListView x:Name="ResourcesList" Grid.Row="1" Visibility="Collapsed" SelectionMode="Multiple">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <local:HarborGlassCard Style="{StaticResource HarborPanel}" Padding="12" CornerRadius="14">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Details}" Opacity="0.72" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Visibility="{Binding ToggleVisibility}" Click="ToggleResource_Click" />
                                                        <Button Content="备份" Visibility="{Binding WorldActions}" Click="BackupWorld_Click" />
                                                        <Button Content="编辑" Visibility="{Binding WorldActions}" Click="EditWorld_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </local:HarborGlassCard>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock x:Name="ResourceCount" FontSize="12" Opacity="0.72" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="CollectWorkspaceMods" Style="{StaticResource HarborPill}" Content="收藏所选模组" Click="CollectInstanceMods_Click" />
                                        <Button x:Name="BackupWorkspaceWorlds" Style="{StaticResource HarborPill}" Content="备份存档" Click="BackupWorlds_Click" />
                                        <Button Style="{StaticResource HarborPill}" Content="刷新" Click="RefreshWorkspaceResources_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="InstanceSettingsCard" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Padding="24" Spacing="24">
                                <Border Padding="23" CornerRadius="21" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Spacing="17">
                                        <TextBlock Text="实例" FontSize="17" FontWeight="SemiBold" />
                                        <StackPanel x:Name="InstanceIconActions" Orientation="Horizontal" Spacing="16">
                                            <Image x:Name="InstanceSettingsIcon" Width="48" Height="48" />
                                            <Button x:Name="WorkspaceChangeIcon" Style="{StaticResource HarborPill}" Content="更换图标…" Click="ChangeInstanceIcon_Click" />
                                            <Button Style="{StaticResource HarborPill}" Content="恢复原图标" Click="ResetInstanceIcon_Click" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,300" ColumnSpacing="16">
                                            <TextBlock Text="显示名称" FontSize="12" VerticalAlignment="Center" />
                                            <TextBox x:Name="InstanceNickname" Grid.Column="1" MaxLength="100" LostFocus="InstanceNickname_LostFocus" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                            <TextBlock Text="目录" FontSize="12" />
                                            <TextBlock x:Name="InstanceSettingsPath" Grid.Column="1" FontSize="10" TextWrapping="Wrap" MaxLines="2" IsTextSelectionEnabled="True" Opacity="0.72" />
                                        </Grid>
                                        <StackPanel x:Name="InstanceFileActions" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="InstanceRepairButton" Style="{StaticResource HarborPill}" Content="校验与修复" Click="Repair_Click" />
                                            <Button x:Name="InstanceExportButton" Style="{StaticResource HarborPill}" Content="导出整合包…" Click="ExportPack_Click" />
                                            <Button x:Name="WorkspaceShortcut" Style="{StaticResource HarborPill}" Content="创建实例快捷方式…" Click="CreateShortcut_Click" />
                                            <Button x:Name="InstanceRevealButton" Style="{StaticResource HarborPill}" Content="在资源管理器中显示" Click="OpenInstanceDirectory_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Padding="23" CornerRadius="21" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Spacing="17">
                                        <TextBlock Text="空间" FontSize="17" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <TextBlock x:Name="InstanceSpaceText" Text="占用空间" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Style="{StaticResource HarborPill}" Content="⟳" Click="MeasureInstanceSpace_Click" AutomationProperties.Name="重新统计实例文件" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Padding="23" CornerRadius="21" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Spacing="17">
                                        <TextBlock Text="运行" FontSize="17" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <TextBlock Text="最大内存" FontSize="12" VerticalAlignment="Center" />
                                            <ComboBox x:Name="InstanceMemory" Grid.Column="1" SelectionChanged="InstanceOptionSelection_Changed">
                                                <ComboBoxItem Content="继承原实例 / 全局设置" />
                                                <ComboBoxItem Content="2 GB" />
                                                <ComboBoxItem Content="3 GB" />
                                                <ComboBoxItem Content="4 GB" />
                                                <ComboBoxItem Content="5 GB" />
                                                <ComboBoxItem Content="6 GB" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="Java" FontSize="12" VerticalAlignment="Center" />
                                            <TextBox x:Name="InstanceJavaPath" Grid.Column="1" PlaceholderText="自动选择兼容版本" FontSize="11" MaxWidth="370" HorizontalAlignment="Right" LostFocus="InstanceOption_LostFocus" />
                                            <Button x:Name="WorkspaceJava" Style="{StaticResource HarborPill}" Content="选择…" Click="ChooseGameJava_Click" Grid.Column="2" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                            <TextBlock Text="全屏" FontSize="12" VerticalAlignment="Center" />
                                            <ToggleSwitch x:Name="InstanceFullscreen" Grid.Column="1" OnContent="" OffContent="" MinWidth="44" Width="44" Toggled="InstanceOptionToggle_Changed" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,78,Auto,78" ColumnSpacing="10">
                                            <TextBlock Text="窗口大小" FontSize="12" VerticalAlignment="Center" />
                                            <NumberBox x:Name="InstanceWidth" Grid.Column="1" Minimum="640" Maximum="7680" ValueChanged="InstanceOptionNumber_Changed" />
                                            <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" />
                                            <NumberBox x:Name="InstanceHeight" Grid.Column="3" Minimum="480" Maximum="4320" ValueChanged="InstanceOptionNumber_Changed" />
                                        </Grid>
                                        <Expander Header="高级" HorizontalAlignment="Stretch">
                                            <TextBox x:Name="InstanceJvmArguments" PlaceholderText="附加 JVM 参数" FontSize="11" MaxLength="4096" LostFocus="InstanceOption_LostFocus" HorizontalAlignment="Stretch" />
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border x:Name="LocalizationCard" Margin="0" Padding="22" Visibility="Collapsed" CornerRadius="0" Background="Transparent">
                            <Grid x:Name="LocalizationWorkspace" Visibility="Collapsed" RowDefinitions="Auto,Auto,*" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel x:Name="LanguageScanSelectors" Orientation="Horizontal" Spacing="8">
                                        <ComboBox x:Name="LanguageInstance" MinWidth="180" DisplayMemberPath="FriendlyName" AutomationProperties.Name="要汉化的游戏实例" SelectionChanged="LanguageInstance_SelectionChanged" />
                                        <Button Content="扫描实例" Click="ScanLanguage_Click" />
                                    </StackPanel>
                                    <Button x:Name="LanguageCancelButton" Grid.Column="1" Content="停止补译" Visibility="Collapsed" Click="CancelLanguageTranslation_Click" />
                                </Grid>
                                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="LanguageActions" Orientation="Horizontal" Spacing="6">
                                            <ComboBox x:Name="LanguageScope" SelectedIndex="0" AutomationProperties.Name="应用范围">
                                                <ComboBoxItem Content="已启用资源" />
                                                <ComboBoxItem Content="当前来源" />
                                            </ComboBox>
                                            <Button Content="CFPA 补全" Click="CommunityLanguage_Click" />
                                            <Button Content="本机补译" Click="MachineLanguage_Click" />
                                            <Button Content="在线补译" Click="OnlineLanguage_Click" />
                                            <Button Content="导入译文" Click="ImportLanguage_Click" />
                                            <Button Content="导出汉化包" Click="ExportLanguage_Click" />
                                            <Button Content="导出原文" Click="ExportLanguageSource_Click" />
                                            <Button Content="应用任务" Click="ApplyLanguage_Click" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <TextBlock x:Name="LanguageSummary" Grid.Row="1" TextWrapping="Wrap" Opacity="0.75" />
                                </Grid>
                                <Grid x:Name="LanguageEditor" Grid.Row="2" ColumnDefinitions="210,*" ColumnSpacing="12">
                                    <ListView x:Name="LanguageSources" SelectionChanged="LanguageSources_SelectionChanged" SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Padding="6" Spacing="4">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Progress}" Opacity="0.68" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="6">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <TextBox x:Name="LanguageQuery" PlaceholderText="搜索原文、译文或语言键" MaxLength="200" />
                                            <CheckBox x:Name="OnlyMissingLanguage" Grid.Column="1" Content="只看待译" />
                                            <Button Grid.Column="2" Content="筛选" Click="FilterLanguage_Click" />
                                        </Grid>
                                        <ListView x:Name="LanguageEntries" Grid.Row="1" SelectionChanged="LanguageEntries_SelectionChanged" SelectionMode="Single">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Padding="4" Spacing="3">
                                                        <TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis" Opacity="0.65" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="PreviousLanguagePage" Content="上一页" Click="PreviousLanguagePage_Click" IsEnabled="False" />
                                            <TextBlock x:Name="LanguagePage" VerticalAlignment="Center" />
                                            <Button x:Name="NextLanguagePage" Content="下一页" Click="NextLanguagePage_Click" IsEnabled="False" />
                                        </StackPanel>
                                        <StackPanel x:Name="LanguageEntryEdit" Grid.Row="3" Spacing="5" Visibility="Collapsed">
                                            <TextBox x:Name="LanguageOriginal" Header="原文" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="86" />
                                            <TextBox x:Name="LanguageDraft" Header="译文" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" MaxLength="100000" />
                                            <TextBlock x:Name="LanguageEntryStatus" TextWrapping="Wrap" Opacity="0.68" />
                                            <Button Content="保存译文" Click="SaveLanguage_Click" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid x:Name="InstanceMediaPage" RowDefinitions="*" Visibility="Collapsed">
                            <GridView x:Name="InstanceScreenshots" Grid.Row="0" IsItemClickEnabled="True" ItemClick="InstanceScreenshot_Click" SelectionMode="None" Visibility="Collapsed" SizeChanged="ScreenshotGrid_SizeChanged" Margin="22,22,7,22" Padding="0">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid ItemWidth="225" ItemHeight="188" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="8" Margin="0,0,15,18">
                                            <Border CornerRadius="15">
                                                <Image Stretch="UniformToFill" Height="150" Loaded="ScreenshotThumbnail_Loaded" Unloaded="ScreenshotThumbnail_Unloaded" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <Grid x:Name="InstanceLogPane" RowDefinitions="Auto,*" Visibility="Collapsed">
                                <Grid Padding="20" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <ComboBox x:Name="InstanceLogFiles" DisplayMemberPath="Name" SelectionChanged="InstanceLog_SelectionChanged" HorizontalAlignment="Left" MinWidth="180" />
                                    <Button Grid.Column="1" Style="{StaticResource HarborPill}" Content="复制" Click="CopyInstanceLog_Click" />
                                    <Button Grid.Column="2" Style="{StaticResource HarborPill}" Content="⟳" Click="RefreshInstanceLog_Click" AutomationProperties.Name="刷新日志" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="InstanceLogText" Text="暂无日志" FontSize="11" IsTextSelectionEnabled="True" Margin="22" />
                                </ScrollViewer>
                            </Grid>
                            <TextBlock x:Name="InstanceMediaEmpty" Grid.Row="0" Opacity="0.72" Text="暂无截图" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </local:HarborGlassCard>
        </Grid>
        <Grid x:Name="WindowChromeOverlay" Height="28" VerticalAlignment="Top">
            <Border Margin="70,0,0,0" Background="Transparent" PointerPressed="ChromeDrag_PointerPressed" DoubleTapped="ChromeDrag_DoubleTapped" />
            <StackPanel x:Name="WindowControlGroup" Orientation="Horizontal" Spacing="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" PointerEntered="ChromeButtons_PointerEntered" PointerExited="ChromeButtons_PointerExited">
                <Button x:Name="ChromeCloseButton" Width="20" Height="24" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="10" Click="ChromeClose_Click" GotFocus="ChromeButton_Focused" LostFocus="ChromeButton_LostFocus" ToolTipService.ToolTip="关闭" AutomationProperties.Name="关闭 MC Harbor">
                    <Grid Width="12" Height="12">
                        <Border x:Name="ChromeCloseDot" CornerRadius="6" Background="#E1695D" />
                        <TextBlock x:Name="ChromeCloseGlyph" Text="×" FontSize="9" FontWeight="Bold" Foreground="#552D1715" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                    </Grid>
                </Button>
                <Button x:Name="ChromeMinimizeButton" Width="20" Height="24" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="10" Click="ChromeMinimize_Click" GotFocus="ChromeButton_Focused" LostFocus="ChromeButton_LostFocus" ToolTipService.ToolTip="最小化" AutomationProperties.Name="最小化 MC Harbor">
                    <Grid Width="12" Height="12">
                        <Border x:Name="ChromeMinimizeDot" CornerRadius="6" Background="#F4C536" />
                        <TextBlock x:Name="ChromeMinimizeGlyph" Text="−" FontSize="9" FontWeight="Bold" Foreground="#55442F00" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                    </Grid>
                </Button>
                <Button x:Name="ChromeMaximizeButton" Width="20" Height="24" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="10" Click="ChromeMaximize_Click" GotFocus="ChromeButton_Focused" LostFocus="ChromeButton_LostFocus" ToolTipService.ToolTip="最大化" AutomationProperties.Name="最大化 MC Harbor">
                    <Grid Width="12" Height="12">
                        <Border x:Name="ChromeMaximizeDot" CornerRadius="6" Background="#65BE36" />
                        <TextBlock x:Name="ChromeMaximizeGlyph" Text="□" FontSize="8" FontWeight="Bold" Foreground="#55304A20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="520" Margin="28" Canvas.ZIndex="40" />
    </Grid>
</Window>
