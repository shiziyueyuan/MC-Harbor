<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="using:MCHarbor.Windows.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MCHarbor.Windows.MainWindow" Title="MC Harbor">
    <Grid x:Name="RootShell" Background="#202020" Loaded="MainWindow_Loaded" SizeChanged="RootShell_SizeChanged">
        <Grid.Resources>
            <SolidColorBrush x:Key="HarborPanelStroke" Color="#38F0F0F0" />
            <Style x:Key="HarborNavigationRow" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="47" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="HarborSettingsRow" TargetType="Button" BasedOn="{StaticResource HarborNavigationRow}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="HarborDisclosureHeader" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <AcrylicBrush x:Key="HarborButtonGlass" TintColor="#353535" TintOpacity="0.72" TintLuminosityOpacity="0.82" FallbackColor="#3F3F3F" />
            <AcrylicBrush x:Key="HarborProminentGlass" TintColor="#BBDDD8" TintOpacity="0.77" TintLuminosityOpacity="0.91" FallbackColor="#BBDDD8" />
            <SolidColorBrush x:Key="HarborProminentText" Color="#142526" />
            <SolidColorBrush x:Key="HarborButtonShadowCore" Color="#A8000000" Opacity="0.24" />
            <LinearGradientBrush x:Key="HarborButtonShadowSoft" StartPoint="0,0" EndPoint="0,1" Opacity="0.24">
                <GradientStop Offset="0.50" Color="#00000000" />
                <GradientStop Offset="1" Color="#5A000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HarborButtonShine" StartPoint="0.1,0" EndPoint="0.65,1">
                <GradientStop Offset="0" Color="#39FFFFFF" />
                <GradientStop Offset="0.48" Color="#0BFFFFFF" />
                <GradientStop Offset="1" Color="#20000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HarborButtonRim" StartPoint="0,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#62FFFFFF" />
                <GradientStop Offset="0.62" Color="#25FFFFFF" />
                <GradientStop Offset="1" Color="#38000000" />
            </LinearGradientBrush>
            <Style x:Key="HarborTabPill" TargetType="Button">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,4" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="HarborPill" TargetType="Button" BasedOn="{StaticResource HarborTabPill}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Background" Value="{StaticResource HarborButtonGlass}" />
                <Setter Property="BorderBrush" Value="{StaticResource HarborButtonRim}" />
                <Setter Property="BorderThickness" Value="0.7" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="PillRoot" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="PillInteraction.Opacity" Value="0.12" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="PillInteraction.Opacity" Value="0.22" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="PillRoot.Opacity" Value="0.55" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Margin="-2,2,-2,-4" CornerRadius="{TemplateBinding CornerRadius}" Background="{StaticResource HarborButtonShadowSoft}" IsHitTestVisible="False" />
                                <Border Margin="-1,1,-1,-2" CornerRadius="{TemplateBinding CornerRadius}" Background="{StaticResource HarborButtonShadowCore}" IsHitTestVisible="False" />
                                <Border CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Background="{TemplateBinding Background}" />
                                <Border CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Background="{StaticResource HarborButtonShine}" />
                                <Border x:Name="PillInteraction" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0" />
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HarborProminentPill" TargetType="Button" BasedOn="{StaticResource HarborPill}">
                <Setter Property="Background" Value="{StaticResource HarborProminentGlass}" />
                <Setter Property="Foreground" Value="{StaticResource HarborProminentText}" />
            </Style>
            <Style x:Key="HarborSegment" TargetType="Button" BasedOn="{StaticResource HarborTabPill}">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="11,2" />
                <Setter Property="MinHeight" Value="25" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="HarborPanel" TargetType="local:HarborGlassCard">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="local:HarborGlassCard">
                            <Grid Background="Transparent">
                                <Canvas x:Name="DecorationLayer" IsHitTestVisible="False">
                                    <Image x:Name="ShadowImage" Width="0" Height="0" Stretch="Fill" Opacity="0" IsHitTestVisible="False" />
                                    <Border x:Name="Surface" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                                    <Border x:Name="Film" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Visibility="Collapsed">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                                                <GradientStop Offset="0" Color="#16FFFFFF" />
                                                <GradientStop Offset="0.52" Color="#00FFFFFF" />
                                                <GradientStop Offset="1" Color="#12000000" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="Highlight" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Visibility="Collapsed">
                                        <Border.Background>
                                            <RadialGradientBrush RadiusX="0.56" RadiusY="0.55" Opacity="0">
                                                <GradientStop Offset="0" Color="#26FFFFFF" />
                                                <GradientStop Offset="0.45" Color="#0CFFFFFF" />
                                                <GradientStop Offset="1" Color="#00FFFFFF" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="Stroke" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                                </Canvas>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="{TemplateBinding Padding}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="BorderThickness" Value="0.7" />
                <Setter Property="BorderBrush" Value="{StaticResource HarborPanelStroke}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
            <Style x:Key="HarborAppearanceChoice" TargetType="RadioButton">
                <Setter Property="Padding" Value="12" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="ChoiceSurface" CornerRadius="20" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="ChoiceSurface.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="ChoiceCheck.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ChoiceSurface.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" />
                                    <TextBlock x:Name="ChoiceCheck" Text="✓" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <local:FavoriteStarConverter x:Key="FavoriteStar" />
        </Grid.Resources>
        <Image x:Name="WallpaperImage" Stretch="Fill" IsHitTestVisible="False" />
        <Border x:Name="WindowGlassLayer" IsHitTestVisible="False" />
        <Border x:Name="WindowGlassTint" IsHitTestVisible="False" />
        <Grid ColumnDefinitions="210,*" x:Name="MainNavigationSurface">
            <Grid x:Name="Sidebar" RowDefinitions="122,*,Auto" Background="Transparent">
                <Border x:Name="SidebarDivider" Grid.RowSpan="3" HorizontalAlignment="Right" Width="1" IsHitTestVisible="False" />
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Top" Margin="28,44,16,0">
                    <Image Source="ms-appx:///Assets/Brand/Mark.png" Width="27" Height="32" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="MC Harbor" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SidebarItems" Spacing="12" Padding="16,0" KeyDown="Sidebar_KeyDown" AutomationProperties.Name="主导航" />
                </ScrollViewer>
                <Button x:Name="CurrentAccountButton" Grid.Row="2" Click="ShowAccounts_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="16,12,16,16" Padding="13" CornerRadius="18" Background="{StaticResource HarborButtonGlass}" BorderBrush="{StaticResource HarborPanelStroke}" BorderThickness="1" AutomationProperties.Name="打开当前账号" Style="{StaticResource HarborPill}">
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="11">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#B77B3B">
                            <Grid Width="28" Height="28">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,28,28" />
                                </Grid.Clip>
                                <Image Source="ms-appx:///Assets/Skins/wide/steve.png" Width="224" Height="224" Margin="-28,-28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" />
                                <Image Source="ms-appx:///Assets/Skins/wide/steve.png" Width="224" Height="224" Margin="-140,-28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" />
                                <Image x:Name="CurrentAccountAvatar" Width="28" Height="28" Stretch="Fill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="CurrentAccountName" Text="离线账号" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CurrentAccountKind" Text="未登录" FontSize="10" Opacity="0.72" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="54,Auto,*">
                <Grid ColumnDefinitions="*,Auto" x:Name="PageTopBar" Height="54" Margin="28,0">
                    <TextBlock x:Name="PageEyebrow" Text="游戏" FontSize="13" FontWeight="SemiBold" Opacity="0.83" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource HarborPill}" Padding="0" Width="32" Height="32" VerticalAlignment="Center" Click="Refresh_Click" AutomationProperties.Name="刷新游戏库" ToolTipService.ToolTip="刷新游戏库">
                        <FontIcon FontSize="14" Glyph="" />
                    </Button>
                </Grid>
                <Grid x:Name="DownloadTabs" Grid.Row="1" Visibility="Collapsed" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="24,9,24,9" Height="34">
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DownloadCategories" Orientation="Horizontal" Spacing="5" AutomationProperties.Name="下载分类">
                            <Button Style="{StaticResource HarborTabPill}" Tag="minecraft" Content="游戏" Click="DownloadTab_Click" Height="34" Padding="14,0" />
                            <Button Style="{StaticResource HarborTabPill}" Tag="mod" Content="模组" Click="DownloadTab_Click" Height="34" Padding="14,0" />
                            <Button Style="{StaticResource HarborTabPill}" Tag="resourcepack" Content="资源包" Click="DownloadTab_Click" Height="34" Padding="14,0" />
                            <Button Style="{StaticResource HarborTabPill}" Tag="shader" Content="光影" Click="DownloadTab_Click" Height="34" Padding="14,0" />
                            <Button Style="{StaticResource HarborTabPill}" Tag="world" Content="地图" Click="DownloadTab_Click" Height="34" Padding="14,0" />
                            <Button Style="{StaticResource HarborTabPill}" Tag="modpack" Content="整合包" Click="DownloadTab_Click" Height="34" Padding="14,0" />
                            <Button Style="{StaticResource HarborTabPill}" Tag="tasks" Content="任务" Click="DownloadTab_Click" Height="34" Padding="14,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="CatalogTargetPicker" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="安装到" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                        <ComboBox x:Name="CatalogInstance" DisplayMemberPath="FriendlyName" Width="260" PlaceholderText="选择实例" AutomationProperties.Name="安装到实例" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Padding="28,14,28,28" RowDefinitions="Auto,Auto,*" x:Name="PageContent" Grid.Row="2">
                    <Grid x:Name="PageHeader" Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="PageTitle" Text="游戏库" FontSize="34" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" LineHeight="41" />
                                <TextBlock x:Name="PageSubtitle" Opacity="0.73" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed" LineHeight="15" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="GameActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
                            <Button Style="{StaticResource HarborPill}" Padding="0" Width="34" Height="34" Click="ImportModpack_Click" AutomationProperties.Name="导入整合包" ToolTipService.ToolTip="导入整合包">
                                <FontIcon FontSize="15" Glyph="" />
                            </Button>
                            <Button Style="{StaticResource HarborProminentPill}" Padding="14,7" Click="GoToDownloads_Click" AutomationProperties.Name="安装 Minecraft" ToolTipService.ToolTip="安装 Minecraft" Content="＋ 安装">
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="AccountTopActions" Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
                            <Button Style="{StaticResource HarborPill}" Content="皮肤库" Click="LittleSkin_Click" />
                            <Button x:Name="ImportHmclTopButton" Style="{StaticResource HarborPill}" Content="导入 HMCL 账号" Click="ImportAccounts_Click" />
                        </StackPanel>
                        <Button x:Name="VersionsRefreshButton" Grid.Column="1" Style="{StaticResource HarborPill}" Padding="0" Width="34" Height="34" VerticalAlignment="Center" Visibility="Collapsed" Click="RefreshVersions_Click" AutomationProperties.Name="刷新版本列表" ToolTipService.ToolTip="刷新版本列表">
                            <FontIcon FontSize="15" Glyph="" />
                        </Button>
                        <Button x:Name="NewModFolderButton" Grid.Column="1" Style="{StaticResource HarborPill}" Content="新建模组夹" VerticalAlignment="Center" Visibility="Collapsed" Click="CreateModFolder_Click" />
                        <Button x:Name="FriendsRefreshButton" Grid.Column="1" Style="{StaticResource HarborPill}" Content="刷新" VerticalAlignment="Center" Visibility="Collapsed" Click="RefreshFriends_Click" />
                        <AutoSuggestBox x:Name="SettingsSearch" Grid.Column="1" Width="280" VerticalAlignment="Center" PlaceholderText="搜索设置" QueryIcon="Find" Visibility="Collapsed" TextChanged="SettingsSearch_TextChanged" QuerySubmitted="SettingsSearch_QuerySubmitted" AutomationProperties.Name="搜索设置" />
                    </Grid>
                    <Grid Grid.Row="2" RowDefinitions="*" Margin="0" x:Name="MainPageBody">
                        <ScrollViewer x:Name="AccountWorkspace" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" SizeChanged="AccountWorkspace_SizeChanged">
                            <Grid x:Name="AccountCardsLayout" RowDefinitions="Auto,0,Auto" ColumnDefinitions="240,*" ColumnSpacing="22" RowSpacing="12" Padding="0,1,0,12">
                                <local:HarborGlassCard x:Name="AccountListCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource HarborPanel}" CornerRadius="24" Padding="0" VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock x:Name="AccountListEmpty" Text="暂无已保存账号" FontSize="12" Opacity="0.73" Margin="16,18" TextWrapping="Wrap" />
                                        <ListView x:Name="AccountsList" SelectionMode="Single" SelectionChanged="Accounts_SelectionChanged" Background="Transparent" BorderThickness="0" Margin="10,10,10,1" Padding="0">
                                            <ListView.Resources>
                                                <CornerRadius x:Key="ListViewItemCornerRadius">15</CornerRadius>
                                                <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                                            </ListView.Resources>
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,9" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="15" CornerRadius="18" Background="#0FFFFFFF">
                                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                            <Border Width="40" Height="40" CornerRadius="8" Background="#B77B3B">
                                                                <Grid Width="40" Height="40">
                                                                    <Grid.Clip>
                                                                        <RectangleGeometry Rect="0,0,40,40" />
                                                                    </Grid.Clip>
                                                                    <Image Source="ms-appx:///Assets/Skins/wide/steve.png" Width="320" Height="320" Margin="-40,-40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" />
                                                                    <Image Source="ms-appx:///Assets/Skins/wide/steve.png" Width="320" Height="320" Margin="-200,-40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" />
                                                                    <Image Source="{Binding Avatar}" Width="40" Height="40" Stretch="Fill" />
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding KindLabel}" FontSize="10" Opacity="0.7" />
                                                            </StackPanel>
                                                            <Grid Grid.Column="2" Width="12" Height="12" VerticalAlignment="Center" Visibility="{Binding SelectedVisibility}">
                                                                <Ellipse Fill="#C3DFDD" />
                                                                <TextBlock Text="✓" FontSize="8" FontWeight="Bold" Foreground="#203334" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </local:HarborGlassCard>
                                <local:HarborGlassCard x:Name="AccountDetailsCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource HarborPanel}" CornerRadius="26" Padding="0">
                                    <Grid RowDefinitions="Auto,335,Auto" Padding="24" RowSpacing="18">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="5">
                                                <TextBlock x:Name="SelectedAccountName" Text="离线账号" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" LineHeight="32" />
                                                <TextBlock x:Name="SelectedAccountKind" Text="Minecraft" FontSize="11" Opacity="0.7" LineHeight="14" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Top">
                                                <Button Style="{StaticResource HarborPill}" Content="⟳" Width="37" Padding="0" Click="RefreshSkin_Click" AutomationProperties.Name="刷新皮肤" ToolTipService.ToolTip="刷新皮肤" />
                                                <DropDownButton Content="···" CornerRadius="16" Padding="9,4" AutomationProperties.Name="账号操作">
                                                    <DropDownButton.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="移除账号" Click="RemoveSelectedAccount_Click" />
                                                        </MenuFlyout>
                                                    </DropDownButton.Flyout>
                                                </DropDownButton>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Height="326" Margin="0,4,0,2" VerticalAlignment="Center">
                                            <local:MinecraftSkinViewport x:Name="AccountSkinViewport" MaxWidth="340" Margin="0,0,3,0" Height="335" />
                                            <TextBlock x:Name="AccountSkinPreviewStatus" Text="选择账号以载入皮肤预览。" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8" IsHitTestVisible="False" TextWrapping="Wrap" Opacity="0.73" />
                                        </Grid>
                                        <StackPanel Grid.Row="2" Spacing="18" Margin="0">
                                            <Border x:Name="SkinMotionTrack" CornerRadius="7" Padding="1" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="1">
                                                    <Button x:Name="SkinStillButton" Style="{StaticResource HarborSegment}" Content="静止" Tag="none" Click="SkinMotion_Click" />
                                                    <Button x:Name="SkinRotateButton" Style="{StaticResource HarborSegment}" Content="旋转" Tag="rotate" Click="SkinMotion_Click" />
                                                    <Button x:Name="SkinWalkButton" Style="{StaticResource HarborSegment}" Content="行走" Tag="walk" Click="SkinMotion_Click" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <TextBlock Text="模型" FontSize="11" Opacity="0.74" VerticalAlignment="Center" MinWidth="49" />
                                                <Border x:Name="SkinModelTrack" CornerRadius="7" Padding="1" Width="170">
                                                    <StackPanel Orientation="Horizontal" Spacing="1">
                                                        <Button x:Name="SkinDefaultModelButton" Style="{StaticResource HarborSegment}" Content="标准" Tag="default" Click="SkinModel_Click" Width="84" />
                                                        <Button x:Name="SkinSlimModelButton" Style="{StaticResource HarborSegment}" Content="纤细" Tag="slim" Click="SkinModel_Click" Width="84" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <Button x:Name="ImportSkinButton" Style="{StaticResource HarborPill}" Click="ImportSkin_Click" AutomationProperties.Name="导入皮肤">
